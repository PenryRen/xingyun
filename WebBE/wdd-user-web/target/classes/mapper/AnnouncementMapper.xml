<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.AnnouncementMapper">

  <select id="page" resultType="com.mindskip.wdd.domain.Announcement" parameterType="com.mindskip.wdd.viewmodel.announcement.AnnouncementPageRequestVM">
    SELECT  *  FROM t_announcement a
    <where>
      and a.deleted = 0
      <if test="announcementArchiveIdList != null and announcementArchiveIdList.size > 0">
        and  a.announcement_archive_id in
        <foreach collection="announcementArchiveIdList" separator="," open="(" close=")" item="id">
          #{id}
        </foreach>
      </if>
      and exists (select 1 from t_announcement_department ad where a.id = ad.announcement_id and ad.department_id = #{departmentId} and ad.deleted= 0)
    </where>
  </select>

</mapper>
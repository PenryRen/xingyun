<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.UserCredentialMapper">

  <select id="page" resultType="com.mindskip.wdd.domain.UserCredential" parameterType="com.mindskip.wdd.viewmodel.credential.CredentialPageRequestVM">
    SELECT  *  FROM t_user_credential
               where deleted = 0 and user_id = #{userId}
  </select>


  <select id="trainCredential" resultType="com.mindskip.wdd.domain.UserCredential">
    SELECT  *  FROM t_user_credential
               where deleted = 0 and train_user_id = #{trainUserId}
    limit 1
  </select>

</mapper>
# OpenAI 兼容模型配置（例如 DeepSeek）
COZE_WORKLOAD_IDENTITY_API_KEY=your-api-key-here
COZE_INTEGRATION_MODEL_BASE_URL=https://api.deepseek.com

# 可选：需要通过宿主机代理访问模型服务时填写。
AGENT_HTTP_PROXY=
AGENT_HTTPS_PROXY=
AGENT_NO_PROXY=localhost,127.0.0.1
COZE_DIRECT_DOH_ENABLED=false
COZE_DOH_REFRESH_SECONDS=300
COZE_LOOP_ENABLED=false

# 工作目录（通常不需要修改）
COZE_WORKSPACE_PATH=/app

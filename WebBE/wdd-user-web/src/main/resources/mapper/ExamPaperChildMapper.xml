<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.ExamPaperChildMapper">

    <select id="selectChildExamPaper"  resultType="com.mindskip.wdd.domain.ExamPaperChild">
        SELECT * FROM t_exam_paper_child
        <where>
             deleted= 0 and exam_paper_id = #{parentExamPaperId} and create_user = #{userId}
        </where>
        limit 1
    </select>

</mapper>

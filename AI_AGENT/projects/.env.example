# Supabase 配置
# 从 Supabase 控制台获取：Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co

# 从 Supabase 控制台获取：Settings -> API -> anon/public key
SUPABASE_KEY=your-anon-key-here

# 豆包大模型配置
# 从火山引擎方舟平台获取
COZE_WORKLOAD_IDENTITY_API_KEY=your-api-key-here
COZE_INTEGRATION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 工作目录（通常不需要修改）
COZE_WORKSPACE_PATH=/app

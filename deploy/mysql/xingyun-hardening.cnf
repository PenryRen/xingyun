# ============================================================
# MySQL 8.0 加固配置
# 放到：/etc/mysql/conf.d/xingyun-hardening.cnf
# 然后：systemctl restart mysql
# 2GB 内存环境专门调优
# ============================================================

[mysqld]
# ------------------------
# 网络安全：禁止外网直连 3306
# ------------------------
bind-address          = 127.0.0.1
# 跳过 DNS 反查，加快连接
skip-name-resolve

# ------------------------
# 数据安全：开启二进制日志（可以时间点恢复）
# 如果你的 MySQL 跑在 podman 容器里，这些默认应该已经在容器里配置
# ------------------------
server-id             = 1
# log_bin               = /var/lib/mysql/mysql-bin
# binlog_format         = ROW
# expire_logs_days      = 7

# ------------------------
# 防止误操作（整表 / 整库删除）
# ------------------------
# sql_safe_updates 强制 UPDATE/DELETE 必须带 WHERE 或者 LIMIT
# 业务代码通常符合这个规范；只有「恶意不带 WHERE 的清空」会被拦
sql_safe_updates      = 1
# sql_mode 取消宽松模式
sql_mode              = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ------------------------
# 内存调优（2GB 机器）
# ------------------------
innodb_buffer_pool_size     = 512M    # 关键：别太大，否则吃爆内存
innodb_log_file_size        = 128M
max_connections             = 100
thread_cache_size           = 8
table_open_cache            = 400
tmp_table_size              = 32M
max_heap_table_size         = 32M
sort_buffer_size            = 1M
read_buffer_size            = 1M
join_buffer_size            = 1M

# ------------------------
# 慢查询日志
# ------------------------
slow_query_log        = 1
slow_query_log_file   = /var/log/mysql/slow.log
long_query_time       = 5
log_queries_not_using_indexes = 0

# ------------------------
# 字符集
# ------------------------
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

[mysqldump]
quick
quote-names
max_allowed_packet    = 256M

[mysql]
default-character-set = utf8mb4

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.ForumCommentMapper">

  <select id="page" resultType="com.mindskip.wdd.domain.ForumComment" parameterType="com.mindskip.wdd.viewmodel.forum.comment.ForumCommentPageRequestVM">
    SELECT  *  FROM t_forum_comment fc
    <where>
      deleted = 0
      <if test="forumId != null">
        and forum_id = #{forumId}
      </if>
      <if test="dataFilterUserId != null">
        and create_user = #{dataFilterUserId}
      </if>
      <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
        and create_department_id in
        <foreach item="item" collection="dataFilterDepartmentList" open="("  close=")" separator="," >
          #{item}
        </foreach>
      </if>
      <if test="userName != null and userName != ''">
        and exists (select 1 from t_user u where fc.create_user=u.id and u.user_name like concat('%',#{userName},'%') and u.deleted= 0 )
      </if>
    </where>
  </select>

</mapper>
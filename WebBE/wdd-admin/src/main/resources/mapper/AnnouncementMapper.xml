<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.AnnouncementMapper">

  <select id="page" resultType="com.mindskip.wdd.domain.Announcement" parameterType="com.mindskip.wdd.viewmodel.announcement.AnnouncementPageRequestVM">
    SELECT  *  FROM t_announcement
    <where>
      deleted= 0
      <if test="title != null and title != ''">
        and  title like concat('%',#{title},'%')
      </if>
      <if test="dataFilterUserId != null">
        and create_user = #{dataFilterUserId}
      </if>
      <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
        and create_department_id in
        <foreach item="item" collection="dataFilterDepartmentList" open="("  close=")" separator="," >
          #{item}
        </foreach>
      </if>
    </where>
  </select>

</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.QuestionMapper">

    <select id="questionRandom"  resultType="com.mindskip.wdd.domain.other.QuestionRandomItem"  parameterType="com.mindskip.wdd.viewmodel.question.QuestionRandom">
        SELECT id as id , question_frame_id as  questionFrameId FROM t_question
        <where>
            deleted= 0
            <if test="questionArchiveIdList != null and questionArchiveIdList.size > 0">
                and  question_archive_id in
                <foreach collection="questionArchiveIdList" separator="," open="(" close=")" item="id">
                    #{id}
                </foreach>
            </if>
            <if test="difficult != null">
                and difficult = #{difficult}
            </if>
            and question_type = #{questionType}
            ORDER BY RAND()  limit #{limit}
        </where>
    </select>

</mapper>
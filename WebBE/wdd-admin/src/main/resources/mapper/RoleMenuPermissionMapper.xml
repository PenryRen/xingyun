<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.RoleMenuPermissionMapper">

  <select id="getRoleMenuPermission" resultType="com.mindskip.wdd.domain.RoleMenuPermission">
    SELECT  *  FROM t_role_menu_permission
    where  deleted=0 and role_id = #{roleId}
  </select>

</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.MenuPermissionMapper">

  <select id="getMenuPermission" parameterType="java.lang.Integer" resultType="com.mindskip.wdd.domain.MenuPermission">
    select  *  from t_menu_permission
    where deleted = 0 and menu_id = #{menuId,jdbcType=INTEGER}
    order by item_order
  </select>

</mapper>
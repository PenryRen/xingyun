<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.CourseWareWatchMapper">

  <select id="getCourseWareWatch" resultType="com.mindskip.wdd.domain.CourseWareWatch">
    select  *  from t_course_ware_watch
    where create_user = #{userId} and course_ware_id = #{courseWareId}
    limit 1
  </select>

</mapper>
# 开发环境配置
# 标记当前为本地开发模式（控制 request.ts 中过期处理逻辑）
VITE_APP_LOCAL_DEVELOPMENT=true

# 系统名称（注入到 index.html 的 title 和 keywords）
VITE_APP_SYSTEM_NAME=芯知天枢实训平台

# 页脚版权信息
VITE_APP_COPYRIGHT=河南财经政法大学麒技团队

# ICP 备案号（本地开发可留空）
VITE_APP_ICP=

# Token 在 Cookie 中的键名
VITE_APP_TOKEN_KEY=User-Token


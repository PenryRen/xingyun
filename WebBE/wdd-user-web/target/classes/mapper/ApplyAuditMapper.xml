<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.ApplyAuditMapper">

    <select id="getApplyAuditByUser" resultType="com.mindskip.wdd.domain.ApplyAudit">
        select  *  from t_apply_audit
        where deleted =0 and user_id = #{userId} and apply_id = #{applyId}
            limit 1
    </select>

</mapper>

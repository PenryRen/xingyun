# 复制为 deps.env 后按需修改（deps.env 请勿提交到版本库）
# cp deps.env.example deps.env

# 若 root 无法用本地 socket 免密登录，填写 root 密码（不推荐写在文件中，可 export 后执行脚本）
# MYSQL_ROOT_PASSWORD=

# 再次执行脚本且已导入过库时设为 1，可跳过 init.sql（避免整库重建）
# SKIP_IMPORT_SQL=0

# MySQL（与 WebBE 各模块 application-prod.yml 中 spring.datasource 一致）
MYSQL_DATABASE=wdd
MYSQL_USER=wdd
MYSQL_PASSWORD=wdd123

# Redis（与 application-prod.yml 中 spring.redis.password 一致）
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# 初始化 SQL 路径（默认：与本脚本同目录下的 init.sql）
# INIT_SQL=/path/to/init.sql

# Nginx（Base/install-nginx.sh；与 install.sh 的 INSTALL_PREFIX 一致）
# INSTALL_PREFIX=/opt/xingyun
# NGINX_CONF_SOURCE=/path/to/nginx.conf.in（模板，含 @@INSTALL_ROOT@@；默认仓库 Nginx/nginx.conf.in）
# NGINX_CONF_TARGET=/etc/nginx/nginx.conf
# 以下为相对 INSTALL_PREFIX 的默认，一般无需改
# UPLOAD_ROOT=${INSTALL_PREFIX}/resource/web-file
# USER_WEB_ROOT=${INSTALL_PREFIX}/web/ueit-user-web
# ADMIN_WEB_ROOT=${INSTALL_PREFIX}/web/ueit-admin
# SKIP_RELOAD=0

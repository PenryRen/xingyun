<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.TrainItemMapper">

  <select id="getTrainItemList" parameterType="java.lang.Integer" resultType="com.mindskip.wdd.domain.TrainItem">
    select  *  from t_train_item
    where deleted =0 and train_id = #{trainId}
  </select>

  <update id="clearTrainItem">
    update t_train_item
    set deleted = 1
    where train_id = #{trainId}
  </update>

</mapper>
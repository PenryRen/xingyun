<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.RoleMapper">


  <select id="list" resultType="com.mindskip.wdd.domain.Role" >
    SELECT  *  FROM t_role
    where  deleted=0
  </select>


  <select id="page" resultType="com.mindskip.wdd.domain.Role" parameterType="com.mindskip.wdd.viewmodel.role.RolePageRequestVM">
    SELECT  *  FROM t_role
    <where>
      and deleted=0
      <if test="name != null and name != ''">
        and  name like concat('%',#{name},'%')
      </if>
    </where>
  </select>

</mapper>
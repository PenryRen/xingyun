# 生产环境配置
# 关闭本地开发模式（启用 403 过期检查等生产逻辑）
VITE_APP_LOCAL_DEVELOPMENT=false

# 系统名称（注入到 index.html 的 title 和 keywords）
VITE_APP_SYSTEM_NAME=领航信创实训平台

# 页脚版权信息
VITE_APP_COPYRIGHT=河南财经政法大学麒技团队

# ICP 备案号（部署上线后填写实际备案号）
VITE_APP_ICP=

# Token 在 Cookie 中的键名
VITE_APP_TOKEN_KEY=User-Token

# RSA 加密公钥（须与后端 wdd-user-web application.yml pair-one public-key 一致）
VITE_APP_PAIR_ONE_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDyL5AyMGbHHJ/5Q8TWlaOhh1vaCFkmzbZ/cFR5sF4CSCmG0qvVpPoH0vgIxrUcmKiwpHcMyNyJ0sTg9xKOidmcWBFlI4vebQEN+Z9D3EnT1XjjQXSJvnnUufAuJilWAdlTeE+K4+zpdoBNpx15h1DeLBS7Xcplf4/ApRqKjc1BoQIDAQAB

# RSA 解密私钥（须与后端 pair-one private-key 一致，用于前端解密场景）
VITE_APP_PAIR_TWO_PRIVATE_

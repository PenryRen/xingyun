# ========================================
# AI 后端环境变量配置模板
# 复制本文件为 .env 后填写真实值
# ========================================

# 独立 MySQL 查询模块配置
# Docker Compose 内运行时 host 使用 mysql；宿主机运行时使用 127.0.0.1
XINGYUN_MYSQL_HOST=127.0.0.1
XINGYUN_MYSQL_PORT=3306
XINGYUN_MYSQL_DATABASE=wdd
XINGYUN_MYSQL_USERNAME=root
XINGYUN_MYSQL_PASSWORD=your_password
# 本地开发默认自动创建缺失的 ai_* 表；生产可先执行 migrations/001_mysql_ai_tables.sql 后设为 false
XINGYUN_MYSQL_AUTO_CREATE_AI_SCHEMA=true

# 大模型配置（讯飞星火 OpenAI 兼容接口）
# 从 https://console.xfyun.cn/ 获取 API Key
OPENAI_API_KEY=your_spark_api_key
OPENAI_BASE_URL=https://spark-api-open.xf-yun.com/v1/
MODEL_NAME=4.0Ultra

# Embedding 模型配置
# 服务器部署时指定本地模型路径，避免从 HuggingFace 下载
# 本地开发时留空则自动从 ModelScope 下载 all-MiniLM-L6-v2
# 服务器路径示例: /opt/Xingyun/ai-agent/models/models/sentence-transformers--all-MiniLM-L6-v2/snapshots/master
EMBEDDING_MODEL_PATH=

# HuggingFace 镜像（国内服务器推荐使用，加速模型下载）
HF_ENDPOINT=https://hf-mirror.com

# 工作目录（通常不需要修改）
WORKSPACE_PATH=.

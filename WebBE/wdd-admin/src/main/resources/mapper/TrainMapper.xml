<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.TrainMapper">

  <select id="page" parameterType="com.mindskip.wdd.viewmodel.train.course.TrainCoursePageRequestVM" resultType="com.mindskip.wdd.domain.Train">
    SELECT  *  FROM t_train
    <where>
      and deleted= 0
      <if test="name != null and name != '' ">
        and name like concat('%',#{name},'%')
      </if>
      <if test="trainArchiveIdList != null and trainArchiveIdList.size() > 0">
        and train_archive_id in
        <foreach item="item" collection="trainArchiveIdList" open="(" separator="," close=")">
          #{item}
        </foreach>
      </if>
      <if test="dataFilterUserId != null">
        and create_user = #{dataFilterUserId}
      </if>
      <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
        and create_department_id in
        <foreach item="item" collection="dataFilterDepartmentList" open="("  close=")" separator="," >
          #{item}
        </foreach>
      </if>
    </where>
  </select>

</mapper>
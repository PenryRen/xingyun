    <delete id="deleteVmWareById" parameterType="Long">
        delete from t_vmware where id = #{id}
    </delete>

    <delete id="deleteVmWareByIds" parameterType="String">
        delete from t_vmware where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


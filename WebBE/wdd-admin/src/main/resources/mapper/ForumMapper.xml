<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.ForumMapper">

  <select id="page" resultType="com.mindskip.wdd.domain.Forum" parameterType="com.mindskip.wdd.viewmodel.forum.ForumPageRequestVM">
    SELECT  *  FROM t_forum
    <where>
      deleted = 0
      <if test="forumArchiveIdList != null and forumArchiveIdList.size > 0">
        and  forum_archive_id in
        <foreach collection="forumArchiveIdList" separator="," open="(" close=")" item="id">
          #{id}
        </foreach>
      </if>
      <if test="dataFilterUserId != null">
        and create_user = #{dataFilterUserId}
      </if>
      <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
        and create_department_id in
        <foreach item="item" collection="dataFilterDepartmentList" open="("  close=")" separator="," >
          #{item}
        </foreach>
      </if>
    </where>
  </select>

</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.ExamPaperBuildMapper">


  <select id="page" resultType="com.mindskip.wdd.domain.ExamPaperBuild" parameterType="com.mindskip.wdd.viewmodel.exam.build.ExamPaperBuildPageRequestVM">
    SELECT *  FROM t_exam_paper_build
    <where>
      and deleted= 0
      <if test="name != null and name != ''">
        and  name like concat('%',#{name},'%')
      </if>
      <if test="examPaperArchiveIdList != null and examPaperArchiveIdList.size > 0">
        and  exam_paper_archive_id in
        <foreach collection="examPaperArchiveIdList" separator="," open="(" close=")" item="id">
          #{id}
        </foreach>
      </if>
      <if test="status != null">
        and build_status = #{status}
      </if>
      <if test="dataFilterUserId != null">
        and create_user = #{dataFilterUserId}
      </if>
      <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
        and create_department_id in
        <foreach item="item" collection="dataFilterDepartmentList" open="("  close=")" separator="," >
          #{item}
        </foreach>
      </if>
    </where>
    order by id desc
  </select>


</mapper>
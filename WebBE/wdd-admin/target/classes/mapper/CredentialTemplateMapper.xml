<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.CredentialTemplateMapper">

  <select id="list" resultType="com.mindskip.wdd.domain.other.KeyValue">
    SELECT name as name , id as value
    FROM t_credential_template
    where  deleted= 0
    <if test="dataFilterUserId != null">
      and create_user = #{dataFilterUserId}
    </if>
    <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
      and create_department_id in
      <foreach item="item" collection="dataFilterDepartmentList" open="(" separator="," close=")">
        #{item}
      </foreach>
    </if>
  </select>

  <select id="page" parameterType="com.mindskip.wdd.viewmodel.credential.CredentialPageRequestVM" resultType="com.mindskip.wdd.domain.CredentialTemplate">
    SELECT  *   FROM t_credential_template
    where  deleted= 0
    <if test="name != null and name != '' ">
      and name like concat('%',#{name},'%')
    </if>
    <if test="selectIdList != null and selectIdList.size>0 ">
      and id not in
      <foreach collection="selectIdList" item="item" separator="," open="(" close=")">
        #{item}
      </foreach>
    </if>
    <if test="dataFilterUserId != null">
      and create_user = #{dataFilterUserId}
    </if>
    <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
      and create_department_id in
      <foreach item="item" collection="dataFilterDepartmentList" open="(" separator="," close=")">
        #{item}
      </foreach>
    </if>
  </select>

</mapper>
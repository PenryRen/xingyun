<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.AnnouncementReadMapper">

  <select id="getByIds"  resultType="com.mindskip.wdd.domain.AnnouncementRead">
    select  *  from t_announcement_read
    where announcement_id = #{announcementId} and create_user = #{userId}
    limit 1
  </select>

</mapper>
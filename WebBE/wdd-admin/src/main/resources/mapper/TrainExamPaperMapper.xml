<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.TrainExamPaperMapper">

  <select id="page" parameterType="com.mindskip.wdd.viewmodel.train.exam.paper.TrainExamPaperPageRequestVM" resultType="com.mindskip.wdd.domain.TrainExamPaper">
    SELECT  *  FROM t_train_exam_paper
    <where>
      and deleted= 0
      <if test="name != null and name != '' ">
        and name like concat('%',#{name},'%')
      </if>
      <if test="examPaperArchiveIdList != null and examPaperArchiveIdList.size() > 0">
        and exam_paper_archive_id in
        <foreach item="item" collection="examPaperArchiveIdList" open="(" separator="," close=")">
          #{item}
        </foreach>
      </if>
      <if test="selectIdList != null and selectIdList.size>0 ">
        and id not in
        <foreach collection="selectIdList" item="item" separator="," open="(" close=")">
          #{item}
        </foreach>
      </if>
      <if test="dataFilterUserId != null">
        and create_user = #{dataFilterUserId}
      </if>
      <if test="dataFilterDepartmentList != null and dataFilterDepartmentList.size() > 0">
        and create_department_id in
        <foreach item="item" collection="dataFilterDepartmentList" open="("  close=")" separator="," >
          #{item}
        </foreach>
      </if>
    </where>
  </select>

</mapper>
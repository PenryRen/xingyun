# 独立 MySQL 查询模块配置
# Docker Compose 内运行时 host 使用 mysql；宿主机运行时使用 127.0.0.1。
XINGYUN_MYSQL_HOST=mysql
XINGYUN_MYSQL_PORT=3306
XINGYUN_MYSQL_DATABASE=wdd
XINGYUN_MYSQL_USERNAME=
XINGYUN_MYSQL_PASSWORD=
# 本地开发默认自动创建缺失的 ai_* 表；生产可先执行 migrations/001_mysql_ai_tables.sql 后设为 false。
XINGYUN_MYSQL_AUTO_CREATE_AI_SCHEMA=true

# 大模型配置
# 从火山引擎方舟平台获取
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 工作目录（通常不需要修改）
WORKSPACE_PATH=.

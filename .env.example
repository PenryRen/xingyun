# 复制为根目录 .env 后填写。未配置时，考试可视化仍可用，生成式答疑与智能组卷保持禁用。
COZE_WORKLOAD_IDENTITY_API_KEY=
COZE_INTEGRATION_MODEL_BASE_URL=

# 可选：本机需要代理访问模型服务时填写。Docker Desktop 使用 host.docker.internal 访问宿主机。
AGENT_HTTP_PROXY=
AGENT_HTTPS_PROXY=
AGENT_NO_PROXY=localhost,127.0.0.1,backend,mysql,redis,nginx,user,admin,agent

# 使用代理时保持 false；仅在明确需要绕过本机 DNS 时设为 true。
COZE_DIRECT_DOH_ENABLED=false
COZE_DOH_REFRESH_SECONDS=300

# 默认关闭外部链路追踪；仅在完成隐私评估后显式开启。
COZE_LOOP_ENABLED=false

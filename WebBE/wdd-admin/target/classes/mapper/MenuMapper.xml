<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.MenuMapper">

  <select id="listAll"  resultType="com.mindskip.wdd.domain.Menu">
    select  *  from t_menu
    where deleted = 0
  </select>


  <select id="list" resultType="com.mindskip.wdd.domain.Menu" parameterType="com.mindskip.wdd.viewmodel.menu.MenuListRequestVM">
    SELECT  *  FROM t_menu
    where  deleted=0 and hidden = 0
    <if test="level != null">
      and level = #{level}
    </if>
    order by item_order
  </select>

  <select id="page" resultType="com.mindskip.wdd.domain.Menu" parameterType="com.mindskip.wdd.viewmodel.menu.MenuPageRequestVM">
    SELECT  *  FROM t_menu
    <where>
      and deleted=0
      <if test="name != null and name != ''">
        and  menu_name like concat('%',#{name},'%')
      </if>
    </where>
  </select>

</mapper>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.UserEventLogMapper">

  <select id="page" parameterType="com.mindskip.wdd.viewmodel.user.event.UserEventPageRequestVM" resultType="com.mindskip.wdd.domain.UserEventLog">

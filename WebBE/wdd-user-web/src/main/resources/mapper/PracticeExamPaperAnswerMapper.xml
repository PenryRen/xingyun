<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindskip.wdd.repository.PracticeExamPaperAnswerMapper">


    <select id="page" resultType="com.mindskip.wdd.domain.PracticeExamPaperAnswer" parameterType="com.mindskip.wdd.viewmodel.exam.answer.ExamPaperAnswerPageRequestVM">
        SELECT  *  FROM t_practice_exam_paper_answer
        <where>
            deleted = 0 and create_user = #{createUser}
            <if test="examPaperArchiveIdList != null and examPaperArchiveIdList.size > 0">
                and  exam_paper_archive_id in
                <foreach collection="examPaperArchiveIdList" separator="," open="(" close=")" item="id">
                    #{id}
                </foreach>
            </if>
            <if test="passed != null">
                and passed = #{passed}
            </if>
        </where>
    </select>


</mapper>
